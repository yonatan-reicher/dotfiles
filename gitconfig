# This is Git's per-user configuration file.
[user]
    name = Jonathan Reicher
    email = yony252525@gmail.com

[core]
    editor = nvim

[color]
    ui = auto

[credential]
    helper = store

[init]
    defaultBranch = main

[push]
    default = simple
    autoSetupRemote = true

[alias]
    # Listing things
    branches = branch -a
    tags = tag
    stashes = stash list
    remotes = remote -v
    unmerged = diff --name-only --diff-filter=U
    # Changes
    unstage = reset HEAD --
    # Undo last commit
    uncommit = reset --mixed HEAD~
    amend = commit --amend --no-edit
    # Graph
    graph = log --graph --branches --remotes --tags --decorate --date-order --oneline
    # Branches
    fast-forward = pull --ff-only
    # Adding
    # Lines starting with "!" execute shell commands. We use it to run
    # multiple git commands, and to take arguments.
    commit-add = "!f() { git add $1 && git commit -m \"add $1\"; }; f"
    commit-update = "!f() { git add $1 && git commit -m \"update $1\"; }; f"
